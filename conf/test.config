/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run robind1/nanolod -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    //
    // Deliberately empty at T1. The workflow body is still a stub, so this profile
    // only checks that parameter validation, initialisation and completion run and
    // exit cleanly. It gains a real tiny dataset in T4, once background preparation
    // and read simulation exist and there is something small enough to run in CI.
    //
    // Until then this profile must not reference test data from an unrelated
    // pipeline: a green CI run on someone else's amplicon samplesheet would be
    // a test of nothing.
}
